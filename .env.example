# ============================================================
# bilibili_rank_vue 环境变量
# 复制此文件为 .env 并填入真实值
# ============================================================

# Cookie 加密密钥（生产环境必填）
# 生成方式：openssl rand -hex 32
NUXT_ENCRYPT_KEY=change-me-to-a-random-32-byte-hex-string

# API 跨域白名单，逗号分隔（生产环境必填，设为你的部署域名）
# NUXT_API_GUARD_ALLOWED_ORIGINS=https://bilibili.zhyv.net

# SQLite 数据库文件路径（可选，默认 ./data/bilibili_rank.db）
# NUXT_DB_PATH=./data/bilibili_rank.db

# 排行榜缓存刷新间隔，单位毫秒（可选，默认 300000，即 5 分钟）
# NUXT_CACHE_WARMER_REFRESH_INTERVAL_MS=300000